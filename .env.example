# Copy this file to .env and fill in ONE key. Never commit .env.

# --- LLM provider -------------------------------------------------------------
# groq (recommended, free tier) | gemini | mistral | openrouter | custom
LLM_PROVIDER=groq

# Key for the selected provider (only the one you use is needed).
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides. Default model per provider: groq openai/gpt-oss-120b,
# gemini gemini-2.5-flash-lite, mistral ministral-8b-latest.
# LLM_MODEL=
# Per-agent models (recommended on Groq to spread the daily token quota):
LLM_MODEL_RISK=openai/gpt-oss-20b
LLM_MODEL_SYNTHESIS=openai/gpt-oss-20b
# LLM_BASE_URL=
# Client-side pacing in requests/minute (defaults: groq 6, mistral 2, gemini 12, openrouter unlimited).
# LLM_MAX_RPM=

# OpenRouter only: per-agent models.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# MODEL_RELEVANCE=mistralai/mistral-small-3.2-24b-instruct
# MODEL_RISK=mistralai/mistral-small-3.2-24b-instruct
# MODEL_SYNTHESIS=mistralai/mistral-small-3.2-24b-instruct

# Optional: improves GitHub API rate limits for the releases adapter.
GITHUB_TOKEN=
# Optional comma-separated overrides for the curated release repositories.
GITHUB_RELEASE_REPOSITORIES=openai/openai-python,langchain-ai/langchain,agno-agi/agno,pydantic/pydantic,huggingface/transformers,pytorch/pytorch
